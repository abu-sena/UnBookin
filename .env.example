# App
NEXT_PUBLIC_APP_URL=https://unbookin.com
# Database
DATABASE_URL=
# Auth
# Local only. Do NOT set on Vercel: Auth.js detects the deployment URL there (see docs/DEPLOY.md).
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Unbookin <halo@unbookin.com>"
# Storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=unbookin-sources
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AI
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=            # diisi founder, 1536 dimensi
BYOK_ENCRYPTION_KEY=        # 32 byte base64
# Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Payments
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Admin
ADMIN_EMAILS=               # dipisah koma, otomatis role admin saat login
# Local Docker DATABASE_URL: postgres://unbookin:unbookin@localhost:5432/unbookin
# Vercel only (build setting, not used by the app): ENABLE_EXPERIMENTAL_COREPACK=1 so Vercel uses the
# pnpm version pinned in package.json "packageManager".
